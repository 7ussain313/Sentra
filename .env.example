# --- PostgreSQL ---
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me

# --- Odoo ---
ODOO_PORT=8069
ODOO_ADMIN_PASSWD=change-me
ODOO_DB_NAME=sentra
ODOO_AGENT_LOGIN=sentra_agent
ODOO_AGENT_API_KEY=

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Web UI (HTTP Basic auth) ---
UI_USERNAME=admin
UI_PASSWORD=change-me

# --- Agent service ---
AGENT_PORT=8000
MAX_STEPS=8
APPROVAL_TIMEOUT_SECONDS=600

# --- Seeded demo users (generated by scripts/seed.py, never commit) ---
SEED_MANAGER_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_AGENT_PASSWORD=

# --- Monitoring ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me
MONITOR_DB_PASSWORD=change-me

# --- Agent DB roles (scripts/create_agent_db_roles.sh) ---
AGENT_DB_RO_PASSWORD=change-me
AGENT_DB_SIGNAL_PASSWORD=change-me
