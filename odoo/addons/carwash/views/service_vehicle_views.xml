<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carwash_service_list" model="ir.ui.view">
        <field name="name">carwash.service.list</field>
        <field name="model">carwash.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="duration"/>
            </tree>
        </field>
    </record>

    <record id="view_carwash_service_form" model="ir.ui.view">
        <field name="name">carwash.service.form</field>
        <field name="model">carwash.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price"/>
                        <field name="duration"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_carwash_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">carwash.service</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_carwash_vehicle_list" model="ir.ui.view">
        <field name="name">carwash.vehicle.list</field>
        <field name="model">carwash.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="plate_number"/>
                <field name="make"/>
                <field name="model"/>
                <field name="owner_id"/>
                <field name="booking_count"/>
            </tree>
        </field>
    </record>

    <record id="view_carwash_vehicle_form" model="ir.ui.view">
        <field name="name">carwash.vehicle.form</field>
        <field name="model">carwash.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="plate_number"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="make"/>
                            <field name="model"/>
                            <field name="booking_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bookings">
                            <field name="booking_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_carwash_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">carwash.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
