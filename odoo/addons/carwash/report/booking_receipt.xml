<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_booking_receipt" model="ir.actions.report">
        <field name="name">Booking Receipt</field>
        <field name="model">carwash.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">carwash.report_booking_receipt</field>
        <field name="report_file">carwash.report_booking_receipt</field>
        <field name="print_report_name">'Receipt - %s' % object.name</field>
        <field name="binding_model_id" ref="model_carwash_booking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_booking_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Booking Receipt <span t-field="o.name"/></h2>
                        <table class="table table-sm mt-4">
                            <tbody>
                                <tr><th>Customer</th><td><span t-field="o.customer_id"/></td></tr>
                                <tr><th>Vehicle</th>
                                    <td><span t-field="o.vehicle_id.plate_number"/>
                                        <t t-if="o.vehicle_id.make or o.vehicle_id.model">
                                            (<span t-field="o.vehicle_id.make"/> <span t-field="o.vehicle_id.model"/>)
                                        </t></td></tr>
                                <tr><th>Service</th><td><span t-field="o.service_id"/></td></tr>
                                <tr><th>Scheduled</th><td><span t-field="o.scheduled_date"/></td></tr>
                                <tr><th>Status</th><td><span t-field="o.state"/></td></tr>
                                <tr><th>Invoice</th><td><span t-field="o.invoice_id"/></td></tr>
                                <tr><th>Total</th>
                                    <td><strong><span t-field="o.price"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td></tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
