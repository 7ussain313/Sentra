<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_carwash" model="ir.module.category">
        <field name="name">Car Wash</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_carwash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Read-only role for the Sentra agents (external API user). Not part of the Staff/Manager chain. -->
    <record id="group_agent_readonly" model="res.groups">
        <field name="name">Agent (read-only)</field>
        <field name="category_id" ref="module_category_carwash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_carwash"/>
        <field name="implied_ids" eval="[(4, ref('group_staff'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
